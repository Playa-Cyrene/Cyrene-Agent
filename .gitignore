# electron-builder 在仓库根生成的产物（与 release/ 同款，不进 git）
latest.yml
*.js.map
*.tsbuildinfo

# Native screenshot helper is built locally and staged for electron-builder.
resources/bin/*.exe

# mpv binary is downloaded locally and staged for electron-builder.
resources/bin/mpv/
.cache/mpv/

# Native gamebot（暂只有本地 Rust 构建产物 target/，暂不进 git）
native/cyrene-gamebot/

# M0 POC scratch（含早期 token/qr.png 敏感产物，仅本地参考）
tmp-m0-poc/

# build/ 顶层是 NSIS 安装包的源资源（installer.nsh / installer-sidebar.bmp /
# cyrene-installer-source.png），被 electron-builder.yml 引用，必须进 Git。
# build/installer/ui/ 是自研安装器 UI 的整个子项目，源码 + 产物都不进 git。
# 兜底：未来若在 build/ 下新增其他子目录（除了上方白名单的 3 个文件），默认全部忽略。
build/*
!build/installer/
build/installer/*
!build/installer/installer.nsh
!build/installer/installer-sidebar.bmp
!build/installer/cyrene-installer-source.png
build/installer/ui/
build/installer/ui/node_modules/
build/installer/ui/dist/
build/installer/ui/dist-electron/
build/installer/ui/dist-installer/
build/installer/ui/payload/
build/installer/ui/dev*.log

# Renderer 构建产物——保留产品资源（audio/avatars/feeling/icons/models/stickers/status），
# 其他 Vite 产物（assets、各窗口 index.html、live2dcubismcore.min.js 等）已在上方忽略。
# 额外兜底：未跟踪的 context-usage 预览图与时间戳备份目录
dist/renderer/context-usage/
dist/renderer-old-*/
# music 播放器是本地构建产物（hash 文件名每次构建变化），不进 git
dist/renderer/music/
# toast 提醒窗口的 index.html 是 Vite 构建产物（引用 hash 文件名，每次构建变化），不进 git。
# 注：该窗口曾是唯一漏掉 ignore 的空窗，其他窗口的 index.html 均已在 lines 10-17 忽略。
dist/renderer/toast/index.html

# build/installer/ui/src/ 下的同名源图（setup/setup-loading/succeed/failed/ch）被安装 UI 引用，
# 打包时由 vite/webpack 复制到 src/renderer/react/assets/ 作为产物副本。
# 真正的源在 build/installer/ui/src/（已在上方 ignore），副本是构建输出，按文件名 ignore 避免误提交。
src/renderer/react/assets/ch.png
src/renderer/react/assets/failed.png
src/renderer/react/assets/setup.png
src/renderer/react/assets/setup-loading.png
src/renderer/react/assets/succeed.png

# OpenCode 二进制 distribution（按需本地下载，不进 git）
resources/opencode/
resources/mingit/
.cache/mingit/
.cache/music-component/
dist/components/

# === 显式产品资源白名单 ===
# 上方 lines 4-23 + 64-86 忽略了 dist/ 下的 Vite 构建产物；
# 以下路径默认被跟踪（无显式 ignore 匹配），是「有意豁免」的产品资源：
#   - dist/renderer/audio        提示音 / 背景音
#   - dist/renderer/avatars      角色头像资源
#   - dist/renderer/stickers     表情贴纸
#   - dist/renderer/icons        品牌 / 供应商 logo（含 deepseek / kimi / claude / glm / custom-endpoint）
#   - dist/renderer/models       Live2D 模型 + 表情 + 物理 + 动作（核心产品资源，含 cyrene 角色）
#   - dist/renderer/splash.html  启动屏（用户首次看到的画面，与各窗口 index.html 不同——splash 是真源非 Vite 产物）
# 用 ! 显式列出 + 注释，让未来维护者一眼看清豁免逻辑，也防止后续误 ignore。
# 新增产品资源请同步追加到此节。

!dist/renderer/audio/
!dist/renderer/avatars/
!dist/renderer/stickers/
!dist/renderer/icons/
!dist/renderer/models/
!dist/renderer/splash.html

