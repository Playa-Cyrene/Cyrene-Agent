{
  "name": "live2d-cyrene",
  "version": "1.2.2",
  "description": "Live2D desktop pet — Cyrene",
  "main": "dist/main/main/index.js",
  "bin": {
    "cyrene": "./dist/cli/index.js"
  },
  "scripts": {
    "build:main": "node -e \"require('fs').rmSync('dist/main/plugins',{recursive:true,force:true})\" && tsc -p tsconfig.main.json && node -e \"const fs=require('fs');fs.cpSync('src/plugins','dist/main/plugins',{recursive:true,filter:s=>fs.statSync(s).isDirectory()||s.endsWith('manifest.json')||s.endsWith('manifest.schema.json')||s.endsWith('native-import.cjs')});fs.cpSync('src/main/plugin-panel','dist/main/plugin-panel',{recursive:true})\"",
    "generate:plugin-schema": "node scripts/plugin-sdk/generate-schema.mjs",
    "check:plugin-schema": "node scripts/plugin-sdk/generate-schema.mjs --check",
    "build:preload": "tsc -p tsconfig.preload.json",
    "check:renderer": "tsc -p tsconfig.renderer.json",
    "build:renderer": "vite build",
    "perf:chat-baseline": "node scripts/perf/chat-renderer-baseline.mjs",
    "build:cli": "node scripts/build/cli.mjs",
    "build:screenshot-helper": "node scripts/build/screenshot-helper.mjs",
    "verify:screenshot-helper": "node scripts/verify/screenshot-helper.mjs resources/bin/cyrene-screenshot.exe",
    "build": "npm run build:main && npm run build:preload && npm run build:cli && npm run build:renderer",
    "prepare:mingit": "node scripts/packaging/prepare-mingit.mjs",
    "prepare:mpv": "node scripts/packaging/prepare-mpv.mjs",
    "prepare:skills": "node scripts/packaging/build-skills-snapshot.mjs",
    "verify:mpv": "node scripts/verify/mpv-helper.mjs resources/bin/mpv/mpv.exe",
    "verify:installer": "node scripts/verify/installer-artifacts.mjs",
    "build:music-component": "node scripts/packaging/build-music-component.mjs",
    "package:win:dir": "npm run build && npm run build:screenshot-helper && npm run prepare:mingit && npm run prepare:mpv && electron-builder --win --dir",
    "dev": "npm run build:main && npm run build:preload && npm run build:cli && concurrently \"vite\" \"cross-env VITE_DEV=1 electron .\"",
    "start": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke:music": "npm run build:main && node scripts/verify/music-smoke.mjs",
    "build:sim": "tsc -p tsconfig.sim.json",
    "sim": "tsc -p tsconfig.sim.json && node dist/sim/main/sim/dmae-sim.js",
    "sim:coffee": "tsc -p tsconfig.sim.json && node dist/sim/main/sim/dmae-sim.js --scenario=coffee",
    "sim:mix": "tsc -p tsconfig.sim.json && node dist/sim/main/sim/dmae-sim.js --scenario=mix",
    "sim:rescue": "tsc -p tsconfig.sim.json && node dist/sim/main/sim/dmae-sim.js --scenario=rescue",
    "sim:sweep": "tsc -p tsconfig.sim.json && node dist/sim/main/sim/dmae-sim.js --scenario=mix --rewardGain=3,5,7,10",
    "sim:l2": "tsc -p tsconfig.sim.json && node dist/sim/main/sim/run-l2-sim.js",
    "build:plugin-sdk": "node scripts/plugin-sdk/build-sdk.mjs",
    "check:plugin-sdk": "node scripts/plugin-sdk/build-sdk.mjs && node scripts/plugin-sdk/verify-package.mjs",
    "test:plugin-examples": "node scripts/plugin-sdk/test-examples.mjs"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=10"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/cross-spawn": "^6.0.6",
    "@types/diff": "^7.0.2",
    "@types/dompurify": "^3.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/qr-image": "^3.2.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^5.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^7.0.3",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4.3.3",
    "ts-json-schema-generator": "^1.5.1",
    "typescript": "^5.6.0",
    "vite": "8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.0",
    "@ag-ui/core": "1.0.0",
    "@ant-design/cssinjs": "^2.1.2",
    "@ant-design/icons": "^6.3.4",
    "@ant-design/x": "^2.9.0",
    "@anthropic-ai/sandbox-runtime": "^0.0.71",
    "@anthropic-ai/sdk": "^0.126.0",
    "@ast-grep/napi": "^0.45.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@lancedb/lancedb": "^0.30.0",
    "@larksuiteoapi/node-sdk": "^1.68.0",
    "@lobehub/icons": "^5.19.3",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@modelcontextprotocol/server-filesystem": "2026.8.31",
    "@node-rs/jieba": "^2.0.1",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@playwright/mcp": "0.0.79",
    "@streamdown/math": "^1.0.2",
    "@xenova/transformers": "^2.17.2",
    "ajv": "^8.20.0",
    "antd": "^6.6.4",
    "beautiful-mermaid": "^1.1.3",
    "chart.js": "^4.5.1",
    "chokidar": "^4.0.3",
    "cross-spawn": "^7.0.6",
    "date-fns": "^4.1.0",
    "diff": "^9.0.0",
    "docx": "^9.7.1",
    "dompurify": "^3.4.12",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "extract-zip": "^2.0.1",
    "gray-matter": "^4.0.3",
    "i18next": "^26.4.0",
    "js-yaml": "^5.0.0",
    "katex": "^0.16.47",
    "llamaindex": "^0.12.1",
    "lucide-react": "^1.32.0",
    "marked": "^16.4.2",
    "mdast-util-to-string": "^4.0.0",
    "music-metadata": "^11.15.0",
    "nodemailer": "^9.0.1",
    "openai": "7.5.0",
    "package-manager-detector": "^1.8.0",
    "pdfkit": "^0.19.1",
    "pixi-live2d-display": "0.5.0-beta",
    "pixi.js": "^7.3.0",
    "playwright": "^1.63.0",
    "qr-image": "^3.2.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react-day-picker": "^9.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.12.4",
    "remark-parse": "^11.0.0",
    "rxjs": "^7.8.1",
    "shiki": "^4.3.1",
    "silk-wasm": "^3.7.1",
    "simple-git": "^3.36.0",
    "simple-icons": "^16.32.0",
    "streamdown": "^2.6.0",
    "turndown": "^7.2.4",
    "unified": "^11.0.5",
    "vscode-icons-js": "^11.6.1",
    "vscode-jsonrpc": "^9.0.1",
    "vscode-languageserver-types": "^3.18.0",
    "wink-bm25-text-search": "^3.1.2",
    "ws": "^8.21.0",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "protobufjs@7.6.4": true,
    "protobufjs@6.11.6": true,
    "electron@43.1.0": true,
    "esbuild@0.21.5": true,
    "sharp@0.32.6": true,
    "tree-sitter@0.22.4": true
  }
}
